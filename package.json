{
  "name": "youtube-video-notetaker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "ng serve",
    "dev:api": "node --env-file-if-exists=.env.local server/index.js",
    "build": "ng build",
    "start": "node server/index.js"
  },
  "dependencies": {
    "@google/genai": "^1.37.0",
    "dompurify": "^3.4.17",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "github-markdown-css": "^5.9.0",
    "helmet": "^8.1.0",
    "marked": "^18.1.2"
  },
  "devDependencies": {
    "@angular/build": "^21.1.0",
    "@angular/cdk": "^21.1.0",
    "@angular/cli": "^21.1.0",
    "@angular/common": "^21.1.0",
    "@angular/compiler": "^21.1.0",
    "@angular/compiler-cli": "^21.1.0",
    "@angular/core": "^21.1.0",
    "@angular/forms": "^21.1.0",
    "@angular/platform-browser": "^21.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "concurrently": "^9.2.0",
    "postcss": "^8.5.32",
    "rxjs": "^7.8.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.2"
  }
}
